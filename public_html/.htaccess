Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On

# Canonical origin: enforce HTTPS and the apex host in one hop.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^relet\.co\.uk$ [NC]
RewriteRule ^ https://relet.co.uk%{REQUEST_URI} [R=301,L,NE]
# Keep all homepage signals on the canonical root URL.
RewriteRule ^index\.(?:html|php)$ / [R=301,L,NC]
RewriteRule ^blog/(void-property-checklist|repair-or-replace|door-maintenance)/?$ /blog/$1.html [R=301,L,NE]
RewriteRule ^blog/?$ blog/index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ blog/post.php?slug=$1 [L,QSA]
RewriteRule ^services/?$ /services.html [R=301,L]
RewriteRule ^repairs\.html$ /landlord-repairs.html [R=301,L]
RewriteRule ^agents\.html$ /letting-agents.html [R=301,L]
RewriteRule ^empty-page-fean2/?$ /about.html [R=301,L]
RewriteRule ^contact/?$ /contact.html [R=301,L]
RewriteRule ^quotation/?$ /contact.html [R=301,L]
RewriteRule ^empty-page-bo8m5/?$ /privacy.html [R=301,L]
RewriteRule ^privacy-2/?$ /terms.html [R=301,L]
# Legacy Grigora / old-site call-to-action routes
RewriteRule ^CTA/?$ /contact.html [R=301,L,NC]
RewriteRule ^appointment/?$ /contact.html [R=301,L,NC]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
